# Copy to .env for local development: cp .env.example .env
# .env is never committed.

# Absolute path to the vault. Use a test vault locally, not your real one.
VAULT_ROOT=/path/to/test-vault

# At least 32 characters. Generate one with: openssl rand -hex 32
MCP_TOKEN=

PORT=3333
HOST=127.0.0.1

# Optional: maximum size of a single write, in bytes.
# MAX_WRITE_BYTES=1000000

# Optional: which server `npm run smoke` runs against.
# MCP_URL=http://127.0.0.1:3333/mcp
